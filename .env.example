# Copy to .env and fill in. Never commit .env.
# --- here.now hosting (https://here.now) ---
HERENOW_API_KEY=
# --- quick replies: the webhook of your "router" agent routine ---
# Rendered into site/.herenow/proxy.json at deploy time. The page posts to /api/reply on its own site,
# and here.now forwards it upstream with the Authorization header added server-side.
GROKPOD_WEBHOOK_URL=
# Set this as a secret on the here.now side; proxy.json only references ${GROKPOD_WEBHOOK_KEY}.
GROKPOD_WEBHOOK_KEY=
# --- where your agent host keeps its data ---
GROKPOD_AGENT_DATA=~/agent-data
# GROKPOD_AGENTS_DIR=~/agent-data/agents
# GROKPOD_INDEX_DB=~/agent-data/search-index.db
# GROKPOD_SIGNOUTS_JSON=~/agent-data/chrome-cookie-signouts.json
# GROKPOD_TRANSCRIPTS_DIR=./transcripts
# id of the agent that runs GrokPod, so it doesn't show up on its own board
GROKPOD_SELF_ID=
# regex for messages your agents send each other (so they don't count as you replying)
# GROKPOD_AGENT_MSG_REGEX=^([A-Z][^\n]{0,40} here[.,:]|Routine check)
# GROKPOD_UTC_OFFSET_HOURS=-3
